    "test:e2e:chromium": "playwright test --project=chromium"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "16.4.5",
    "typescript": "^5.9.3",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
