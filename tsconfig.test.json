{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "out-test",
    "rootDir": "src",
    "noEmit": false
  },
  "include": ["src/lib/address.ts", "src/lib/types.ts", "src/lib/formulas.ts", "src/lib/history.ts", "src/lib/fixtures.ts", "src/lib/clipboard.ts"],
  "exclude": ["node_modules"]
}
